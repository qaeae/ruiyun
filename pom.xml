<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.wms.platform</groupId>
    <artifactId>wms-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>wms-platform</name>
    <description>智能化仓库平台（空间租赁 + 代发货 + 物流代结算）· 模块化单体骨架</description>

    <!--
      模块清单 = 《02-MVP功能清单与排期》§5.2 的落地起点（先模块化单体，确有需要再拆网关/物流/调度）
        wms-common    公共基础设施（统一响应/错误码/幂等/雪花ID/PII/追踪）——被业务模块依赖，反向禁止
        wms-core      业务模块化单体（内部按 12 个业务域分包：md/auth/acct/cs/inbound/iv/outbound/logistics/fns/gate/rpt/health）
        wms-archtest  ArchUnit 模块边界守护（只做校验，不产出制品）
      网关、物流独立服务、调度服务：一期不拆（见 02 §5.2 M1 与方案 §9 技术架构）
    -->
    <modules>
        <module>wms-kernel</module>
        <module>wms-common</module>
        <module>wms-discovery</module>
        <!-- P0 拆分：领域模块（依赖方向见各模块 pom 顶部注释，禁止反向依赖） -->
        <module>wms-mod-au</module>
        <module>wms-mod-md</module>
        <module>wms-mod-acct</module>
        <module>wms-mod-iv</module>
        <module>wms-mod-fns</module>
        <module>wms-mod-ops</module>
        <module>wms-mod-pda</module>
        <module>wms-mod-logistics</module>
        <!-- W6：出库域（依赖 iv/md/acct/logistics，故排在其后） -->
        <module>wms-mod-outbound</module>
        <!-- 独立服务（P1.2 从单体拆出） -->
        <module>wms-auth</module>
        <module>wms-masterdata</module>
        <module>wms-fns</module>
        <!-- 网关（WebFlux）：鉴权、限流、路由 -->
        <module>wms-gateway</module>
        <!-- 应用装配：启动类 + 横切配置 + 资源与迁移 + 全部测试 -->
        <module>wms-core</module>
        <module>wms-archtest</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 版本策略：以下版本组合均已存在于本机 ~/.m2 仓库，构建无需大规模下载 -->
        <spring-boot.version>3.5.15</spring-boot.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <archunit.version>1.3.0</archunit.version>
        <lombok.version>1.18.42</lombok.version>
        <!-- 规范条目 B8：Po/Dto/Ro/Vo 之间一律走 MapStruct，禁止手写 Bean 拷贝 -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <!-- 规范条目 B10：需要可变集合时用 CollUtil（Hutool），不用不可变工厂 -->
        <hutool.version>5.8.46</hutool.version>
        <!--
            Nacos 客户端：只引 nacos-client（**不引 spring-cloud-alibaba**）。

            为什么不引 spring-cloud-alibaba（重要，别改回去）：
            Maven Central 上最新的 spring-cloud-alibaba-dependencies 是 2023.0.3.3，
            它对应的 Spring Cloud 2023.0.x 只支持 Spring Boot 3.2/3.3，而本项目是 **Boot 3.5.15**。
            强行混用属于"不受支持的组合"，会出现 Bean 冲突/启动失败且没有官方支持路径。
            我们 P0.5 只需要两件事：注册实例、拉取配置——nacos-client 直接就能做，零版本耦合。

            版本对齐：服务端是 nacos-server:v2.5.4，客户端取同一 2.5.x 线（2.5.1），避免协议不匹配。
        -->
        <nacos-client.version>2.5.1</nacos-client.version>
        <!-- XXL-JOB 2.4.2：与机器上已有的 admin 镜像 2.4.2 保持一致（版本不匹配会导致注册/触发失败） -->
        <xxl-job.version>2.4.2</xxl-job.version>
        <!-- MinIO Java SDK（P5 对象存储）：8.5.x 对应 MinIO RELEASE.2024-xx 服务端 -->
        <minio.version>8.5.11</minio.version>
        <!-- 与 Spring Boot 3.5.15 配套的 Spring Cloud 训练版（配错会出现 Bean 冲突/启动失败） -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
        <it.skip>true</it.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM：2025.0.x 对应 Spring Boot 3.5.x（务必与 spring-boot.version 匹配） -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client</artifactId>
                <version>${nacos-client.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 本项目自有模块 -->
            <dependency>
                <groupId>com.wms.platform</groupId>
                <artifactId>wms-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wms.platform</groupId>
                <artifactId>wms-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 三方（Boot BOM 未管理者显式声明） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- B8：Po/Dto/Ro/Vo 映射统一走 MapStruct，禁止手写 Bean 拷贝 -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- B10：集合构造工具（需要可变集合时用 CollUtil，而非不可变工厂） -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <!-- B8：Lombok 与 MapStruct 同栈时必须加 binding，否则 MapStruct 读不到 Lombok 生成的 getter/setter -->
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- 单元测试：默认执行；集成测试（*IT）由 failsafe + it.skip 控制 -->
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <skipITs>${it.skip}</skipITs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
