<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wms.platform</groupId>
        <artifactId>wms-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wms-core</artifactId>
    <name>wms-core</name>
    <description>业务模块化单体：12 个业务域（md/auth/acct/cs/inbound/iv/outbound/logistics/fns/gate/rpt/health）</description>

    <dependencies>
        <!-- 应用装配模块依赖全部领域模块（它是"唯一知道所有领域"的地方） -->
        <dependency>
            <groupId>com.wms.platform</groupId>
            <artifactId>wms-mod-au</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.wms.platform</groupId>
            <artifactId>wms-mod-md</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.wms.platform</groupId>
            <artifactId>wms-mod-iv</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.wms.platform</groupId>
            <artifactId>wms-mod-ops</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.wms.platform</groupId>
            <artifactId>wms-mod-pda</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.wms.platform</groupId>
            <artifactId>wms-mod-logistics</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- W6：出库域与账户域（本轮最小面：费用冻结/释放）；二者均在本进程内，靠模块依赖协作而非 HTTP -->
        <dependency>
            <groupId>com.wms.platform</groupId>
            <artifactId>wms-mod-outbound</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.wms.platform</groupId>
            <artifactId>wms-mod-acct</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.wms.platform</groupId>
            <artifactId>wms-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 持久化：MyBatis-Plus + MySQL + Flyway（迁移脚本由 01-数据模型DDL与状态机.md 生成） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.wms.platform.WmsPlatformApplication</mainClass>
                    <!--
                      必须指定 classifier：否则 repackage 会用 fat jar **替换主制品**，而 fat jar 的类位于
                      BOOT-INF/classes/ 下，ArchUnit 按 com/wms/platform/ 解析包根时匹配不到，
                      wms-archtest 会"看不到业务模块的类"→ 7 条边界规则全部静默通过（假绿）。
                      加上 classifier 后：普通 jar 作为主制品（供 archtest 扫描与其他模块依赖），
                      可执行 jar 为 wms-core-<version>-boot.jar（供容器运行）。
                      该问题由 ArchUnitSetupTest 发现，勿移除该 classifier。
                    -->
                    <classifier>boot</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
